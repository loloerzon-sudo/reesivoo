# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
SESSION_SECRET=reesivoo_session_secret_change_in_production_key_12345

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (optional fallback vision OCR, get from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional comma-separated model overrides (defaults to free vision models)
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,minimax/minimax-m3:free,z-ai/glm-5.2:free,meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen-2.5-vl-72b-instruct:free

# Google OAuth 2.0 Credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Turso Cloud Database (optional for local dev, strongly recommended for production/Render)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
